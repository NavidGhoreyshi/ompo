{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./web/src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
