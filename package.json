{
  "name": "ompo",
  "version": "0.2.0",
  "description": "OMP Roadmap Orchestrator — long-horizon sequential workflow driver for stock omp (no core fork). Implements OMP_ROADMAP_ORCHESTRATOR_PLAN.md §§5–6, 11–14 out-of-core via `omp -p` workers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NavidGhoreyshi/ompo.git"
  },
  "homepage": "https://github.com/NavidGhoreyshi/ompo#readme",
  "bugs": {
    "url": "https://github.com/NavidGhoreyshi/ompo/issues"
  },
  "keywords": [
    "omp",
    "orchestrator",
    "agents",
    "roadmap",
    "autonomous",
    "bun",
    "dashboard"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "ompo": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "start": "bun src/cli.ts",
    "web:build": "bunx vite build --config web/vite.config.ts && bun scripts/embed-web.ts",
    "release:gate": "bun test tests/release-gate.test.ts",
    "build": "bun run web:build && bun build --compile src/cli.ts --outfile ompo",
    "test:e2e": "playwright test",
    "deck:desktop:check": "bun scripts/deck-desktop-check.ts",
    "deck:desktop:dev": "bun scripts/deck-desktop-run.ts dev",
    "deck:desktop:build": "bun scripts/deck-desktop-run.ts build",
    "deck:captures": "bun scripts/deck-captures.ts",
    "ux05:compare": "bun scripts/ux05-compare.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react-devtools-core": "^7.0.1",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ink": "^7.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "0.186.0"
  }
}
