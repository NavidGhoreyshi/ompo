# ompo project-local config — all keys optional.
# User-level model roles live in ~/.config/ompo/config.yml (`ompo setup`):
# deepModel drives orchestrator/reviewer/debugger, fastModel the worker.
# Keys here override the global slots for this project only.
# workerModel: model pattern passed to `omp --model` for every slice worker.
#   Omit to use your configured default model. Paid opencode-go model pinned
#   so workers share the subscription pool (override hard slices via `Agent:`).
workerModel: opencode-go/muse-spark-1.3-contributor
# reviewModel: model for the independent post-merge review session. Fresh
# context, own model — the orchestrator's second pair of eyes on each slice.
# Defaults to the deep slot (global deepModel, or workerModel when unset).
reviewModel: opencode-go/muse-spark-1.3-contributor
# modelFallbacks: ordered fallback models when the primary is unavailable
#   (rate limit, unknown id). Tried in order within the same attempt — no
#   retry consumed, partial work preserved. Omp's default model is the
#   implicit last resort after these.
modelFallbacks:
  - opencode-go/mimo-v2.5
  - muse-spark-1.3-contributor-free
  - deepseek-v4-flash-free
maxRetries: 1
specBudget: 12000
workerTimeoutSec: 900
# placeholders: false disables dev-only auto-injection for missing env
#   credentials (default: on — values noted in the run's placeholders.md,
#   deploy slices still wait for real values).
# agentModels: per-slice `Agent:` name → model pattern.
agentModels:
  task: opencode-go/muse-spark-1.3-contributor
# verifyDefaults: commands prepended before every slice's `Verify:` steps.
verifyDefaults: []
# services: shared infra the loop brings up itself (self-sufficient to deploy).
#   serviceUp: idempotent bring-up, run before workers + on healable gate blocks.
#   serviceReady: readiness probes polled after bring-up (exit 0 = ready).
#   serviceEnv: extra env for worker + gate commands (e.g. DATABASE_URL).
#   serviceTimeoutSec: ready-poll budget (default 120).
# serviceUp:
#   - docker compose up -d db
# serviceReady:
#   - pg_isready -h localhost -p 5432
# serviceEnv:
#   DATABASE_URL: postgresql://localhost:5432/ompo_dev
# serviceTimeoutSec: 120
# maxUnblocks: 2 end-of-run unblock sessions before giving up (0 disables,
#   --no-unblock / --max-unblocks N override per run)
# contextCapTokens: 120000 per-session tokens before handoff to a fresh session
#   (0 disables, --no-handoff / --context-cap N override per run)
