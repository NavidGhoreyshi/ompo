{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal desktop capability for the ompo deck shell (roadmap slice d12): the window itself plus spawning the bundled ompo sidecar. No fs, http, dialog, notification, updater or opener permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ompo",
          "cmd": "binaries/ompo",
          "args": true,
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "binaries/ompo",
          "cmd": "binaries/ompo",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-stdin-write",
      "allow": [
        {
          "name": "binaries/ompo",
          "cmd": "binaries/ompo",
          "sidecar": true
        }
      ]
    }
  ]
}
