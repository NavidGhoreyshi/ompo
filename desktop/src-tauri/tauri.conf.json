{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ompo deck",
  "version": "0.2.0",
  "identifier": "com.ompo.deck",
  "build": {
    "frontendDist": "http://127.0.0.1:4317",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ompo deck",
        "width": 1600,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ompo"],
    "resources": {}
  }
}
